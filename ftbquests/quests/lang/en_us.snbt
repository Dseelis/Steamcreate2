	quest.00000000000000CD.quest_desc: ["Should be able to nab some of these to get you started from a village."]
	quest.00000000000000CD.title: "Potato, Potatoe"
	quest.000000000000072E.quest_desc: ["Let those stalks reach for the sky!"]
	quest.000000000000072E.title: "Sugar or Paper?"
	quest.0000000000000FC0.quest_desc: [
		"The following are your basic crops that will always be handy when you are hungry."
		""
		"The quests following the initial crops give a basic recipe to help keep you fed but look to REI for more complex and fullfilling recipes."
	]
	quest.0000000000000FC2.quest_desc: ["Desert adventure time."]
	quest.0000000000000FC2.title: "Cacti"
	quest.0000000000000FC4.title: "Sugar"
	quest.0000000000000FC6.quest_desc: ["I am supposed to beat a root?"]
	quest.0000000000000FCE.quest_desc: ["Man I will be able to write so much stuff on this."]
