	quest.0000000000000FD0.title: "Carrot"
	quest.0000000000000FD2.quest_desc: ["Have to eat some melons to make some melons."]
	quest.0000000000000FD4.quest_desc: ["You don't have jack on me Mr. Pumpkin!"]
	quest.0000000000000FD6.quest_desc: ["Nether fortress mold."]
	quest.0000000000000FD6.title: "Hell Wart"
	quest.0000000000000FD8.quest_desc: ["You are going to have to travel to the great white north to find some of these delicous berries."]
	quest.0000000000000FD8.title: "Sweet Berries"
	quest.000000000000132B.quest_desc: ["Eggs o'plenty!"]
	quest.0009F48B6E385A47.quest_desc: ["The &aGravi Star&r is the final upgraded Nether Star in GTCEu. It's needed for &3UV&r Sensors, Emitters, and Field Generators."]
	quest.0009F48B6E385A47.quest_subtitle: "Unfortunately, doesn't make you float"
	quest.0009F48B6E385A47.title: "Gravi Star"
	quest.0017FFFAD7CD2EFE.quest_desc: [
